# ---------------------------------------------------------------------------
# Picnic Raffle Manager configuration.
# Copy this file to ".env" and adjust as needed. All values have safe defaults.
# ---------------------------------------------------------------------------

# Display name shown throughout the app.
APP_NAME=Picnic Raffle Manager

# PINs. CHANGE THESE before a live event.
ADMIN_PIN=1234
VOLUNTEER_PIN=0000

# Database. SQLite is the default (stored on the /data volume).
# For PostgreSQL, use e.g.:
#   DATABASE_URL=postgresql+psycopg2://raffle:raffle@postgres:5432/raffle
DATABASE_URL=sqlite:////data/raffle.db
DEMO_DATABASE_URL=sqlite:////data/raffle-demo.db

# Set to true to run a safe dry run against the separate demo database.
DEMO_MODE=false

# Backups.
BACKUP_DIR=/data/backups
BACKUP_INTERVAL=15
ENABLE_PERIODIC_BACKUP=true

# Public TV display behaviour.
DISPLAY_ROTATION_SECONDS=8
NEW_WINNER_HIGHLIGHT_SECONDS=9
WINNERS_PER_PAGE=8

# Raffle rules. When false, a ticket that already won cannot win again
# without an admin override.
ALLOW_REPEAT_TICKET_WINNERS=false
